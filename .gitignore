# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and secrets: commit an example file instead,
# such as config.example.toml or .env.example
.env
.env.*
!.env.example
*.local.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Background Editor: local model evaluation (downloaded photos, caches, result sheets)
bench/

# Downloaded models and per-run data (never commit models)
models/
data/
*.onnx
*.part

# Running from source with this file present switches to portable mode
/portable.conf
