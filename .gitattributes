#
# Text files keep LF line endings on every platform, also on Windows with
# core.autocrlf=true: build.ps1 checks LICENSE and tools/licenses/LGPL-3.0.txt by their
# SHA-256, and the source zip should hold the files exactly as they are in the repository.
* text=auto eol=lf

*.ico binary
*.jpg binary
*.png binary
*.bmp binary

# Large binary files are stored on the Optimey LFS server (see .lfsconfig), never in git itself.
# Anything else above 500 kB is refused by the check-added-large-files hook.
*.7z          filter=lfs diff=lfs merge=lfs -text
